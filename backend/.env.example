# رابط قاعدة البيانات: بيقرأه التطبيق وprisma db push معًا (directUrl = env("DATABASE_URL") في schema.prisma)
DATABASE_URL=
# DIRECT_URL انشال: كان بلايسهولدر على المنصة وPrisma كان بيفشل وقت client init قبل ما يوصل لـ DATABASE_URL
# 64 حرف عشوائي: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=
# مفتاح Vercel Cron لـ /api/cron/projects-sync
CRON_SECRET=
# فاضي = أي أصل مسموح. أو قائمة مفصولة بفواصل: دومين الواجهة + http://127.0.0.1:43124
CORS_ORIGIN=
MANAGERS_API_URL=
MANAGERS_API_TOKEN=
PROJECTS_SYNC_INTERVAL_MIN=
# متكتبش PORT على منصة الاستضافة — بتحدده هي
PORT=
# 1 = /api/health/db يرجّع نص خطأ القاعدة في الرد (كلمات السر بتتحجب) — للتشخيص المؤقت بس
HEALTH_DEBUG=
