generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  // Vercel بيبني على Debian (1.1) لكن الـFunction بتشتغل على Amazon Linux 2023 (rhel-openssl-3.0.x)
  // — من غير الهدف ده الـclient بيتولّد لـdebian وبيفشل وقت التشغيل: «could not locate the Query Engine».
  // Wasmer لسه محتاجة debian-openssl-1.1.x.
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  schemas   = ["core", "ops", "log"]
  url       = env("DATABASE_URL")
  // كان env("DIRECT_URL") — قيمة DIRECT_URL على المنصة Placeholder، وPrisma بيفشل وقت الـ client init
  // قبل ما يوصل لـ url. القاعدة اتنقلت لـ Postgres الخاص بـ Wasmer: اتصال واحد يكفي.
  directUrl = env("DATABASE_URL")
}

enum Role {
  ROOT
  ADMIN
  MANAGER
  USER

  @@schema("core")
}

enum WorkType {
  MAINTENANCE
  REPAIR

  @@schema("core")
}

enum WorkStatus {
  NEW
  IN_PROGRESS
  DONE
  WAITING_PARTS

  @@schema("core")
}

enum RepairOrderStatus {
  PENDING
  RECEIVED
  IN_REPAIR
  REPAIRED
  LOADED
  RETURNED

  @@schema("core")
}

enum Condition {
  GOOD
  BROKEN
  STOPPED

  @@schema("core")
}

enum TrackingMode {
  HOURS
  KM
  BOTH

  @@schema("core")
}

enum NeedRequestStatus {
  DRAFT
  SENT
  FAILED

  @@schema("core")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyLogs           DailyLog[]
  maintenance         Maintenance[]
  auditLogs           AuditLog[]
  repairOrdersCreated RepairOrder[]
  repairOrderEvents   RepairOrderEvent[]
  needRequestsCreated NeedRequest[]
  projects            UserProject[]
  oilConsumptions     OilConsumption[]
  reviewSubmitted     ReviewRequest[] @relation("ReviewSubmitted")
  reviewReviewed      ReviewRequest[] @relation("ReviewReviewed")

  @@schema("core")
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@schema("ops")
}

model ReviewRequest {
  id              Int          @id @default(autoincrement())
  entity          String
  status          ReviewStatus  @default(PENDING_REVIEW)
  clientRequestId String?       @unique
  submittedById   Int
  submittedBy     User          @relation("ReviewSubmitted", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt     DateTime      @default(now())
  reviewedById    Int?
  reviewedBy      User?         @relation("ReviewReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  submittedData   Json
  reviewedData    Json?
  equipmentId     Int?
  projectId       Int?
  sectorId        Int?
  projectName     String?
  projectCode     String?
  sectorName      String?
  equipmentCode   String?
  equipmentName   String?
  contextSource   String?
  capturedAt      DateTime?
  recordId        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, entity])
  @@index([submittedById])
  @@schema("ops")
}

model Project {
  id          Int      @id @default(autoincrement())
  code        String?  @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sectors        Sector[]
  projectSectors ProjectSector[]
  equipment      Equipment[]
  faults         Fault[]
  repairOrders   RepairOrder[]
  needRequests   NeedRequest[]
  dailyLogs      DailyLog[]
  maintenance    Maintenance[]
  assignments    EquipmentAssignment[]
  users          UserProject[]

  @@schema("core")
}

model UserProject {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
  @@schema("core")
}

model ProjectSector {
  id             Int      @id @default(autoincrement())
  projectId      Int
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sectorId       Int
  sector         Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  normalizedName String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  repairOrders RepairOrder[]
  needRequests NeedRequest[]
  faults       Fault[]
  assignments  EquipmentAssignment[]

  @@unique([projectId, sectorId])
  @@unique([projectId, normalizedName])
  @@index([sectorId])
  @@schema("core")
}

model Sector {
  id                Int      @id @default(autoincrement())
  projectId         Int?
  project           Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name              String
  /// معرّف قطاع نظام المدرين (room_id) — بيبقى null للقطاعات غير المربوطة؛ الربط مراجعة يدوية مش تشابه أسماء
  managersRoomId    Int?
  managersRoomTitle String?

  projectSectors ProjectSector[]
  equipment      Equipment[]
  faults         Fault[]
  repairOrders   RepairOrder[]
  needRequests   NeedRequest[]
  dailyLogs      DailyLog[]
  maintenance    Maintenance[]
  assignments    EquipmentAssignment[]

  @@unique([projectId, name])
  @@schema("core")
}

model EquipmentCategory {
  id                  Int          @id @default(autoincrement())
  name                String       @unique
  codePrefixes        String[]     @default([])
  defaultTrackingMode TrackingMode @default(BOTH)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  equipment Equipment[]

  @@schema("core")
}

model Equipment {
  id                     Int                @id @default(autoincrement())
  code                   String             @unique
  name                   String
  projectId              Int?
  sectorId               Int?
  categoryId             Int?
  trackingMode           TrackingMode       @default(BOTH)
  trackingModeOverridden Boolean            @default(false)
  trackingModeConfirmed  Boolean            @default(false)
  /// Legacy field kept only for the tracking-mode migration; do not use in new logic.
  hasOdometer            Boolean            @default(true)
  project                Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sector                 Sector?            @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  category               EquipmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  dailyLogs       DailyLog[]
  maintenance     Maintenance[]
  oilSchedules    OilSchedule[]
  partSchedules   PartSchedule[]
  meterResets     MeterReset[]
  faults          Fault[]
  repairOrders    RepairOrder[]
  oilConsumptions OilConsumption[]
  assignments     EquipmentAssignment[]

  @@schema("core")
}

/// Equipment assignment history with an effective interval.
///
/// System Managers is the source of truth for projects/sectors but exposes only
/// the CURRENT assignment (GET /equipments). It provides no transfer dates, so
/// rows here are recorded only when EFMS observes a change, with effectiveFrom
/// set to the observation time. Nothing is ever backdated.
model EquipmentAssignment {
  id              Int            @id @default(autoincrement())
  equipmentId     Int
  equipment       Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  projectId       Int?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId        Int?
  sector          Sector?        @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  projectSectorId Int?
  projectSector   ProjectSector? @relation(fields: [projectSectorId], references: [id], onDelete: SetNull)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  sourceSystem    String
  sourceReference String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([equipmentId, effectiveFrom])
  @@index([equipmentId, effectiveTo])
  @@schema("ops")
}

model MeterReset {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  hours       Float?
  km          Float?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([equipmentId, date])
  @@schema("ops")
}

model RepairOrder {
  id                     Int                @id @default(autoincrement())
  requestNo              Int                @unique
  type                   String             @default("INTERNAL")
  projectId              Int?
  project                Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId               Int?
  sector                 Sector?            @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  projectSectorId        Int?
  projectSector          ProjectSector?     @relation(fields: [projectSectorId], references: [id], onDelete: Restrict)
  equipmentId            Int
  equipment              Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  entryDate              DateTime?          @db.Date
  exitDate               DateTime?          @db.Date
  hours                  Float?
  km                     Float?
  workshop               String?
  faultDescription       String
  actionTaken            String?
  itemName               String?
  partModel              String?
  itemCode               String?
  technicalCode          String?
  quantity               Int                @default(1)
  unit                   String             @default("عدد")
  itemCondition          String             @default("عاطلة")
  siteName               String?
  requesterName          String?
  sourceWarehouseId      Int?
  destinationWarehouseId Int?
  technicianPhone        String?
  imageUrl               String?
  imageBase64            String?            @db.Text
  estimatedCost          Float?
  actualCost             Float?
  notes                  String?            @db.Text
  status                 RepairOrderStatus  @default(PENDING)
  sentAt                 DateTime?
  sendError              String?
  managersRef            String?
  managersId             Int?               @unique
  managersStatus         String?
  managersSyncedAt       DateTime?
  parts                  RepairPart[]
  events                 RepairOrderEvent[]
  createdById            Int?
  createdBy              User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@schema("ops")
}

model RepairPart {
  id            Int         @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  qty           Float?
  notes         String?
  createdAt     DateTime    @default(now())

  @@schema("ops")
}

model RepairOrderEvent {
  id            Int               @id @default(autoincrement())
  repairOrderId Int
  repairOrder   RepairOrder       @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  status        RepairOrderStatus
  userId        Int?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime          @default(now())

  @@schema("ops")
}

model NeedRequest {
  id               Int               @id @default(autoincrement())
  requestNo        Int               @unique
  projectId        Int?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId         Int?
  sector           Sector?           @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  projectSectorId  Int?
  projectSector    ProjectSector?    @relation(fields: [projectSectorId], references: [id], onDelete: Restrict)
  department       String
  requestDate      DateTime          @db.Date
  status           NeedRequestStatus @default(DRAFT)
  sentAt           DateTime?
  sendError        String?
  managersRef      String?
  managersId       Int?              @unique
  managersStatus   String?
  managersSyncedAt DateTime?
  items            NeedRequestItem[]
  createdById      Int?
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@schema("ops")
}

model NeedRequestItem {
  id             Int         @id @default(autoincrement())
  needRequestId  Int
  needRequest    NeedRequest @relation(fields: [needRequestId], references: [id], onDelete: Cascade)
  rowNo          Int
  itemName       String
  itemCode       String?
  unit           String?
  qty            Float
  equipmentRef   String?
  currentBalance Float?
  localSupply    Float?
  foreignSupply  Float?
  notes          String?
  createdAt      DateTime    @default(now())

  @@schema("ops")
}

model DailyLog {
  id                Int        @id @default(autoincrement())
  date              DateTime   @db.Date
  equipmentId       Int
  equipment         Equipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  /// Legacy: نهاية العداد كانت تُسجَّل معها قراءة بداية — لم تعد تُدخل ولا تُعرض، والعمود باقٍ لبيانات ما قبل التعديل.
  startMeter        Float?
  endMeter          Float?
  operatingHours    Float?
  diesel            Float?
  /// Legacy: كانت الإنتاجية نصًا حرًا (كمية + نوع في خلية واحدة)؛ استُبدلت بالنوع والعدد.
  productivity      String?
  productivityType  String?
  productivityCount Float?
  condition         Condition?
  conditionNote     String?
  notes             String?
  projectId         Int?
  project           Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId          Int?
  sector            Sector?    @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  contextSource     String?
  projectCode       String?
  projectName       String?
  sectorName        String?
  equipmentCode     String?
  equipmentName     String?
  userId            Int?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([date, equipmentId])
  @@schema("ops")
}

model Maintenance {
  id              Int              @id @default(autoincrement())
  workOrderNo     Int?
  date            DateTime         @db.Date
  endDate         DateTime?        @db.Date
  equipmentId     Int
  equipment       Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  workType        WorkType
  orderType       String?
  maintenanceType String?
  workshop        String?
  description     String?
  action          String?
  parts           String?
  meterReading    Float?
  kmMeter         Float?
  downtime        Float?
  status          WorkStatus       @default(NEW)
  notes           String?
  projectId       Int?
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId        Int?
  sector          Sector?          @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  contextSource   String?
  projectCode     String?
  projectName     String?
  sectorName      String?
  equipmentCode   String?
  equipmentName   String?
  clientRequestId String?          @unique
  operationId     String?          @unique
  userId          Int?
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workParts       WorkPart[]
  oilConsumptions OilConsumption[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@schema("ops")
}

model WorkPart {
  id            Int         @id @default(autoincrement())
  maintenanceId Int
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  qty           Float?
  notes         String?
  createdAt     DateTime    @default(now())

  @@schema("ops")
}

/// أنواع الزيوت المستخدمة في المعدات
enum OilType {
  ENGINE
  HYDRAULIC
  STEERING
  GEARBOX
  OTHER

  @@schema("core")
}

/// مصدر قيد الاستهلاك: يدوي أو مستورد من أمر صيانة
enum OilSource {
  MANUAL
  MAINTENANCE

  @@schema("core")
}

/// قيد استهلاك زيت — إما إدخال يدوي أو مستورد تلقائيًا من صيانة (WorkPart فيها اسم زيت)
model OilConsumption {
  id            Int          @id @default(autoincrement())
  date          DateTime     @db.Date
  equipmentId   Int
  equipment     Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  oilType       OilType
  /// اسم الزيت الحر (مثال: "shell rimula 15w40") — اختياري للتفصيل
  oilName       String?
  /// الكمية المستهلكة باللترات
  liters        Float
  /// سعر اللتر (اختياري)
  pricePerLiter Float?
  /// الإجمالي = liters × pricePerLiter (يُحتسب تلقائيًا)
  totalAmount   Float?
  source        OilSource    @default(MANUAL)
  /// مرجع أمر الصيانة لو القيد مستورد تلقائيًا
  maintenanceId Int?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  notes         String?
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([equipmentId, date])
  @@index([oilType])
  @@index([source])
  @@schema("ops")
}

model OilSchedule {
  id                 Int       @id @default(autoincrement())
  equipmentId        Int
  equipment          Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  oilType            String
  lastChangeMeter    Float
  intervalHours      Float
  warningBeforeHours Float     @default(10)
  nextDueMeter       Float
  lastServiceId      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([equipmentId, oilType])
  @@schema("ops")
}

model PartSchedule {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  partName    String
  interval    Float
  unit        String    @default("ساعة")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([equipmentId, partName])
  @@schema("ops")
}

model Fault {
  id              Int            @id @default(autoincrement())
  date            DateTime       @db.Date
  projectId       Int?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sectorId        Int?
  sector          Sector?        @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  projectSectorId Int?
  projectSector   ProjectSector? @relation(fields: [projectSectorId], references: [id], onDelete: Restrict)
  equipmentId     Int
  equipment       Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  description     String
  cause           String?
  faultType       String?
  downtimeHours   Float?
  actionTaken     String?
  status          WorkStatus     @default(NEW)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@schema("ops")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  recordId  Int
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@schema("log")
}

/// سجل استيراد شيتات الإكسل — يتيح حذف بيانات شيت بعينه لاحقًا
model ImportLog {
  id         Int      @id @default(autoincrement())
  entity     String
  fileName   String
  sheetName  String
  created    Int      @default(0)
  updated    Int      @default(0)
  skipped    Int      @default(0)
  /// معرّفات السجلات التي أنشأها هذا الاستيراد (للحذف الانتقائي)
  createdIds Json?
  createdAt  DateTime @default(now())

  @@index([entity])
  @@schema("log")
}
