{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:deploy",
  "devCommand": "npm run dev",
  "functions": {
    "api/**": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/projects-sync",
      "schedule": "0 3 * * *"
    }
  ]
}
